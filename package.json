{
  "name": "jbsnap-workspace",
  "private": true,
  "scripts": {
    "setup": "npm run install-all && npm run db:generate",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install-all": "npm install --prefix backend && npm install --prefix frontend",
    "db:generate": "npm run prisma:generate --prefix backend",
    "db:push": "npm run prisma:push --prefix backend",
    "db:studio": "npm run prisma:studio --prefix backend"
  }
}
