# =====================================================================
# JBSnap Frontend Environment Configuration
# Copy this file to .env.local or .env
# =====================================================================

# ── REQUIRED: Backend API URL ─────────────────────────────────────────
# Points to your running Fastify backend gateway
NEXT_PUBLIC_API_URL="http://localhost:5000"

# ── OPTIONAL: Google OAuth Sign-In ───────────────────────────────────
# If provided, enables "Sign in with Google" modal on Login and Register
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
